{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/build_and_push_backend.Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m primeagent run --backend-only --host 0.0.0.0 --port ${PORT:-8080}",
    "healthcheckPath": "/health_check",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
